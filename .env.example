# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic API key for Maia (server only).
ANTHROPIC_API_KEY=

# Supabase project: Project Settings → API keys / Data API.
# The publishable key is meant to be public; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated emails allowed to use Maia (recommended once deployed).
ALLOWED_EMAILS=

# Scheduled weekly reports (Vercel Cron). The secret key is the Supabase
# project's server-only key: never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=
# Any long random string; Vercel sends it with each scheduled run.
CRON_SECRET=

# Phone notifications (Web Push). Make the key pair on the app's Reminders
# page ("Make keys"); the subject is mailto: plus your email.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
